datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  VIEWER
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  IN_PRODUCTION
  DELIVERED
  PAID
  CANCELLED
}

enum DiscountType {
  PERCENT
  FLAT
  NONE
}

enum PaymentMode {
  CASH
  UPI
  BANK
  CHEQUE
}

model User {
  id                 String     @id @default(cuid())
  email              String     @unique
  name               String?
  passwordHash       String
  role               Role       @default(STAFF)
  mustChangePassword Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  deletedAt          DateTime?
  createdById        String?
  updatedById        String?

  quotesCreated    Quote[]    @relation("QuoteCreatedBy")
  quotesUpdated    Quote[]    @relation("QuoteUpdatedBy")
  auditLogs        AuditLog[]
  paymentsRecorded Payment[]  @relation("PaymentRecordedBy")

  @@index([email])
  @@index([role])
  @@index([deletedAt])
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  email       String?
  address     String?
  building    String?
  flat        String?
  city        String?
  state       String    @default("Karnataka")
  pincode     String?
  gstin       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  quotes Quote[]

  @@index([name])
  @@index([phone])
  @@index([building])
  @@index([flat])
  @@index([deletedAt])
}

model Product {
  id          String    @id @default(cuid())
  name        String
  code        String?   @unique
  description String?
  rate        Decimal
  hsn         String?
  gstRate     Decimal   @default(18)
  unit        String    @default("SQFT")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  quoteItems QuoteItem[]

  @@index([name])
  @@index([deletedAt])
}

model Factory {
  id          String    @id @default(cuid())
  name        String
  code        String?
  address     String?
  phone       String?
  email       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  quotes Quote[]

  @@index([name])
  @@index([deletedAt])
}

model MasterRow {
  id               String    @id @default(cuid())
  rowOrder         Int       @default(0)
  clientName       String    @default("")
  flat             String?   @default("")
  building         String?   @default("")
  state            String    @default("Karnataka")
  factory          String?   @default("Veera Glass")
  status           String    @default("Draft")
  notes            String?   @default("")
  productId        String?
  description      String    @default("")
  frameHeightMm    Decimal   @default(0)
  frameWidthMm     Decimal   @default(0)
  quantity         Int       @default(1)
  rate             Decimal   @default(0)
  discountType     String    @default("NONE")
  discountValue    Decimal   @default(0)
  // Computed values
  roundedHeightMm  Decimal   @default(0)
  roundedWidthMm   Decimal   @default(0)
  glassCutHeightMm Decimal   @default(0)
  glassCutWidthMm  Decimal   @default(0)
  sqft             Decimal   @default(0)
  runningFeet      Decimal   @default(0)
  netAmount        Decimal   @default(0)
  gstAmount        Decimal   @default(0)
  totalAmount      Decimal   @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  @@index([clientName])
  @@index([building])
  @@index([flat])
  @@index([status])
  @@index([rowOrder])
  @@index([deletedAt])
}

model Quote {
  id               String       @id @default(cuid())
  quoteNumber      String       @unique
  version          Int          @default(1)
  status           QuoteStatus  @default(DRAFT)
  customerId       String?
  customer         Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerPhone    String?
  customerAddress  String?
  customerBuilding String?
  customerFlat     String?
  customerState    String       @default("Karnataka")
  destinationState String       @default("Karnataka")
  factoryId        String?
  factory          Factory?     @relation(fields: [factoryId], references: [id], onDelete: SetNull)
  discountType     DiscountType @default(NONE)
  discountValue    Decimal      @default(0)
  freight          Decimal      @default(0)
  validUntil       DateTime?

  // Revisions tracking
  parentQuoteId    String?
  parentQuote      Quote?       @relation("QuoteRevisions", fields: [parentQuoteId], references: [id], onDelete: SetNull)
  revisions        Quote[]      @relation("QuoteRevisions")
  revisionNotes    String?

  // Totals snapshot
  subTotal          Decimal @default(0)
  cgstTotal         Decimal @default(0)
  sgstTotal         Decimal @default(0)
  igstTotal         Decimal @default(0)
  gstTotal          Decimal @default(0)
  grandTotal        Decimal @default(0)
  roundOff          Decimal @default(0)
  displayTotal      Decimal @default(0)
  displayTotalWords String?
  notes             String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  createdBy   User?     @relation("QuoteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?
  updatedBy   User?     @relation("QuoteUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  items    QuoteItem[]
  payments Payment[]

  @@index([quoteNumber])
  @@index([status])
  @@index([customerId])
  @@index([factoryId])
  @@index([parentQuoteId])
  @@index([createdAt])
  @@index([deletedAt])
}

model QuoteItem {
  id          String       @id @default(cuid())
  quoteId     String
  quote       Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  itemOrder   Int          @default(0)
  description String?

  // Inputs
  frameHeightMm Decimal
  frameWidthMm  Decimal
  quantity      Int          @default(1)
  rate          Decimal
  discountType  DiscountType @default(NONE)
  discountValue Decimal      @default(0)

  // Computed fields
  roundedHeightMm  Decimal
  roundedWidthMm   Decimal
  glassCutHeightMm Decimal
  glassCutWidthMm  Decimal
  sqft             Decimal
  runningFeet      Decimal
  grossAmount      Decimal
  discountAmount   Decimal @default(0)
  netAmount        Decimal
  taxableAmount    Decimal
  cgstRate         Decimal @default(0)
  sgstRate         Decimal @default(0)
  igstRate         Decimal @default(0)
  cgstAmount       Decimal @default(0)
  sgstAmount       Decimal @default(0)
  igstAmount       Decimal @default(0)
  gstAmount        Decimal @default(0)
  totalAmount      Decimal

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  createdById String?
  updatedById String?

  @@index([quoteId])
  @@index([productId])
  @@index([deletedAt])
}

model Payment {
  id            String      @id @default(cuid())
  quoteId       String
  quote         Quote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  receiptNumber String      @unique
  milestone     String      // "70% Advance", "20% Delivery", "10% Completion", or "Custom"
  amount        Decimal
  mode          PaymentMode @default(BANK)
  reference     String?     // Transaction ID, cheque number, etc.
  paymentDate   DateTime    @default(now())
  notes         String?
  recordedById  String?
  recordedBy    User?       @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@index([quoteId])
  @@index([receiptNumber])
  @@index([paymentDate])
  @@index([deletedAt])
}

model Setting {
  id          String    @id @default(cuid())
  key         String    @unique
  value       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([key])
  @@index([deletedAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  entityName    String
  entityId      String
  action        String   // CREATE, UPDATE, DELETE, LOGIN, PASSWORD_CHANGE, etc.
  performedById String?
  performedBy   User?    @relation(fields: [performedById], references: [id], onDelete: SetNull)
  details       String?  // JSON with before / after diff
  ipAddress     String?
  createdAt     DateTime @default(now())

  @@index([entityName, entityId])
  @@index([performedById])
  @@index([createdAt])
}
